{
  // In-repo support for the examples: maps every `@xtandard/entitlements/*` import
  // string to the local source, so the examples typecheck (`bun run typecheck:examples`)
  // AND run (Bun honors `paths` at runtime) without a build or an install — framework
  // packages resolve from the repo root's node_modules. Keep it complete: one entry per
  // package.json `exports` key (test/examples.test.ts checks). When an example is copied
  // out, `bun install` the published package (its package.json lists it) and drop this.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@xtandard/entitlements": ["../src/index.ts"],
      "@xtandard/entitlements/catalog": ["../src/catalog.ts"],
      "@xtandard/entitlements/testing": ["../src/testing.ts"],
      "@xtandard/entitlements/storage/memory": ["../src/entry-storage-memory.ts"],
      "@xtandard/entitlements/counters/memory": ["../src/entry-counters-memory.ts"],
      "@xtandard/entitlements/counters/buffered": ["../src/entry-counters-buffered.ts"],
      "@xtandard/entitlements/counters/kv": ["../src/entry-counters-kv.ts"],
      "@xtandard/entitlements/auth/none": ["../src/entry-auth-none.ts"],
      "@xtandard/entitlements/auth/basic": ["../src/entry-auth-basic.ts"],
      "@xtandard/entitlements/auth/delegated": ["../src/entry-auth-delegated.ts"],
      "@xtandard/entitlements/authorization/none": ["../src/entry-authorization-none.ts"],
      "@xtandard/entitlements/authorization/roles": ["../src/entry-authorization-roles.ts"],
      "@xtandard/entitlements/authorization/delegated": ["../src/entry-authorization-delegated.ts"],
      "@xtandard/entitlements/hooks/log": ["../src/entry-hooks-log.ts"],
      "@xtandard/entitlements/bun": ["../src/entry-bun.ts"],
      "@xtandard/entitlements/elysia": ["../src/entry-elysia.ts"],
      "@xtandard/entitlements/elysia2": ["../src/entry-elysia2.ts"],
      "@xtandard/entitlements/express": ["../src/entry-express.ts"],
      "@xtandard/entitlements/hono": ["../src/entry-hono.ts"],
      "@xtandard/entitlements/next": ["../src/entry-next.ts"],
      "@xtandard/entitlements/storage/file": ["../src/entry-storage-file.ts"],
      "@xtandard/entitlements/storage/redis": ["../src/entry-storage-redis.ts"],
      "@xtandard/entitlements/storage/postgres": ["../src/entry-storage-postgres.ts"],
      "@xtandard/entitlements/storage/drizzle": ["../src/entry-storage-drizzle.ts"],
      "@xtandard/entitlements/storage/mongodb": ["../src/entry-storage-mongodb.ts"],
      "@xtandard/entitlements/storage/sqlite": ["../src/entry-storage-sqlite.ts"],
      "@xtandard/entitlements/storage/libsql": ["../src/entry-storage-libsql.ts"],
      "@xtandard/entitlements/storage/unstorage": ["../src/entry-storage-unstorage.ts"],
      "@xtandard/entitlements/storage/cloudflare-kv": ["../src/entry-storage-cloudflare-kv.ts"],
      "@xtandard/entitlements/drizzle/pg": ["../src/entry-drizzle-pg.ts"],
      "@xtandard/entitlements/drizzle/mysql": ["../src/entry-drizzle-mysql.ts"],
      "@xtandard/entitlements/drizzle/sqlite": ["../src/entry-drizzle-sqlite.ts"],
      "@xtandard/entitlements/counters/redis": ["../src/entry-counters-redis.ts"],
      "@xtandard/entitlements/counters/postgres": ["../src/entry-counters-postgres.ts"],
      "@xtandard/entitlements/counters/sqlite": ["../src/entry-counters-sqlite.ts"],
      "@xtandard/entitlements/counters/libsql": ["../src/entry-counters-libsql.ts"],
      "@xtandard/entitlements/counters/mongodb": ["../src/entry-counters-mongodb.ts"],
      "@xtandard/entitlements/counters/drizzle": ["../src/entry-counters-drizzle.ts"],
      "@xtandard/entitlements/billing": ["../src/entry-billing.ts"],
      "@xtandard/entitlements/billing/stripe": ["../src/entry-billing-stripe.ts"],
      "@xtandard/entitlements/billing/polar": ["../src/entry-billing-polar.ts"],
      "@xtandard/entitlements/billing/paddle": ["../src/entry-billing-paddle.ts"],
      "@xtandard/entitlements/billing/lemonsqueezy": ["../src/entry-billing-lemonsqueezy.ts"],
      "@xtandard/entitlements/billing/better-auth": ["../src/entry-billing-better-auth.ts"],
      "@xtandard/entitlements/billing/manual": ["../src/entry-billing-manual.ts"],
      "@xtandard/entitlements/flags": ["../src/entry-flags.ts"],
      "@xtandard/entitlements/bridges/audit": ["../src/entry-bridges-audit.ts"],
      "@xtandard/entitlements/bridges/webhooks": ["../src/entry-bridges-webhooks.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../scripts/example.ts"],
  // elysia2 is checked against Elysia 2 via its own elysia2/tsconfig.json.
  // next/.next and next-env.d.ts are generated by `next dev`.
  "exclude": ["**/node_modules/**", "elysia2/**", "next/.next/**", "next/next-env.d.ts"]
}
